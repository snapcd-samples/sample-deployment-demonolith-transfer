# The session environment. step1_env.sh copies this to .env (gitignored);
# every later step runs `source .env` first, so each command carries the
# state-store credentials — the values docker-compose.yml starts MinIO
# with. They authenticate against the local container only; no AWS anywhere.
#
# Keep the `export` prefixes: only exported values reach tofu and demonolith.
export AWS_ACCESS_KEY_ID="minioadmin"
export AWS_SECRET_ACCESS_KEY="minioadmin"
